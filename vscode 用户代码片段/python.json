    "PHEADER":{
        "prefix": "Pheader",
        "body": [
        "# -*- encoding: utf-8 -*-",
        "#python>=3.6",
        "'''",
        "@File    :   $TM_FILENAME",
        "@Time    :   $CURRENT_YEAR/$CURRENT_MONTH/$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND",
        "@Author  :   sunyan",
        "@Version :   1.0",
        "@email   :   c_yansun",
        "@Desc    :   None",
        
        "'''",
        "",
        "# here put the import lib",
        "import os, sys, time",
        "import traceback",
        "import codecs",
        "import logging",
        "#log_dict = {} #全局变量存储日志",
        "time_str = time.strftime('%Y-%m-%d_%H-%M-%S',time.localtime(time.time()))",
        "logging.basicConfig(level = logging.DEBUG,",
        "        filename=rf'{time_str}_test.log', # **** 需指定logpath的存储地址",
        "           encoding='utf-8',                   #不设置编码可能乱码",
        "        format = '%(asctime)s - %(name)s - [%(funcName)s]-%(module)s-logger: %(name)s- %(lineno)d - %(levelname)s - %(message)s')",
        "logger = logging.getLogger(__name__)",
        "logger.setLevel(logging.DEBUG)",
        "logging.getLogger('selenium').setLevel(logging.WARNING) #selenium 日志界别设置，屏蔽selenium 中warning级别以下的日志",
        "logging.getLogger('urllib3.connectionpool').setLevel(logging.WARNING) #urllib3.connectionpool 日志界别设置 同上..",
        "class DictLogHandler(logging.Handler):",
        "    def __init__(self):",
        "       super().__init__()",
        "       self.log_dict = {}  # 使用局部变量存储日志",
        "",
        "    def AnalysisMsgObject(self, record:object):",
        "        '''",
        "        @Time    :   2024/07/19 17:05:07",
        "        @功能    :   解析logger对象",
        "        '''",
        "        if record.exc_info:",
        "            stack_trace = ''.join(traceback.format_exception(*record.exc_info))",
        "            # 将堆栈跟踪信息添加到日志消息中",
        "            record.stack_trace = '\\nStack Trace:\\n' + stack_trace",
        "        # 获取实例的所有属性和方法名称",
        "        attributes_and_methods = dir(record)",
        "        info_dict = {}",
        "        # 遍历属性和方法名称",
        "        for attr in attributes_and_methods:",
        "",
        "            if attr.startswith('__'): continue",
        "            # 使用getattr获取属性或方法的引用",
        "            attr_value = getattr(record, attr)",
        "            ",
        "            # 检查属性值是否是方法（即检查是否可调用）",
        "            if not callable(attr_value):",
        "                # 如果是属性，则打印它的值",
        "                info_dict[attr] = attr_value",
        "                pass",
        "",
        "        info_dict['created'] = time.strftime('%Y-%m-%d %H:%M:%S',time.localtime(info_dict['created']))",
        "        {",
        "            'args':'存储日志消息的参数，如果日志消息是一个字符串格式化的占位符',",
        "            'created':'表示日志条目被创建的时间戳，即记录日志那一刻的时间',",
        "            'exc_info':'异常信息，如果日志条目是通过exc_info=True参数调用日志方法记录的',",
        "            'exc_text':'异常文本，通常包含异常类型和异常消息',",
        "            'filename':'记录日志的源代码文件的名称，即发生日志记录的那一行代码所在的文件',",
        "            'funcName':'记录日志的函数名称',",
        "            'levelname':'日志条目的级别名称，例如DEBUG、INFO、WARNING、ERROR、CRITICAL',",
        "            'levelno':'日志条目的级别数值，每个日志级别对应一个整数值',",
        "            'lineno':'记录日志的源代码文件中的行号',",
        "            'module':'记录日志的模块名称',",
        "            'msecs':'日志条目创建时间的时间部分的毫秒',",
        "            'msg':'日志消息的文本内容',",
        "            'name':'记录日志的Logger对象的名称',",
        "            'pathname':'记录日志的源代码文件的完整路径',",
        "            'process':'日志条目被创建的进程ID',",
        "            'processName':'日志条目被创建的进程名称',",
        "            'relativeCreated':'日志条目创建时间相对于日志记录开始的时间的偏移量（毫秒）',",
        "            'stack_info':'如果日志条目是通过stack_info=True参数调用日志方法记录的，将包含调用堆栈的信息',",
        "            'taskName':'在使用concurrent.futures或asyncio等并发或异步编程时，当前任务的名称',",
        "            'thread':'日志条目被创建的线程ID',",
        "            'threadName':'日志条目被创建的线程名称',",
        "        }",
        "",
        "        print(f'log time: {time_str}')",
        "        print(info_dict['msg'].strip())",
        "        print(info_dict.get('stack_trace'))",
        "        return info_dict",
        "    ",
        "    def emit(self, record):",
        "        #global log_dict",
        "        # 获取日志记录的基本信息",
        "        self.log_dict = self.AnalysisMsgObject(record)",
        "        #log_dict = self.AnalysisMsgObject(record) #使用全局变量存储",
        "        #log_entry = self.format(record)",
        "        # 将日志记录存储到字典中，使用日志级别作为键",
        "        #if record.levelname not in log_dict:",
        "        #    log_dict[record.levelname] = []",
        "        #log_dict[record.levelname].append(log_entry)",
        "",
        "logger.addHandler(DictLogHandler())",
        "#logging 用例如下",
        "#logger.info('流程输出与信息，观察整体执行')",
        "",
        "# 记录一些日志",
        "logger.debug('This is a debug message')",
        "# 获取日志结果",
        "log_handler = next(handler for handler in logger.handlers if isinstance(handler, DictLogHandler))",
        "log_results = log_handler.log_dict",
        "#print(log_dict)",
        "#logger.debug('输出调试信息，信息更加全面')",
        "#logger.warning('某种原因已发的警告信息，但是系统可以正常的运行')",
        "#logger.error('程序异常自我修复，不能正常运行')",
        "#logger.fatal('比error错误更加严重的错误')",
        "",
        "def log_exceptions_to_file_decorator(file_name=rf'{os.getcwd()}\\error_info.log'):",
        "    def decorator(func):",
        "        def wrapper(*args, **kwargs):",
        "            try:",
        "                return func(*args, **kwargs)",
        "            except Exception as e:",
        "                with open(file_name, 'a') as f:",
        "                    traceback.print_exception(type(e), e, e.__traceback__, file=f)",
        "                    traceback.print_tb(e.__traceback__, file=f)",
        "                    traceback.print_exc(file=f)",
        "        return wrapper",
        "    return decorator",
        "# #  使用装饰器 demo",
        "# @log_exceptions_to_file_decorator()",
        "# def divide(x, y):",
        "#     return x / y",
        "# #  调用函数，模拟出现异常",
        "# divide(1,  0)",
        "$0"
    ],
    },
