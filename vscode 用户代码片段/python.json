            "def set_console_title(title:str=None):",
            "    '''",
            "    @Time    :   2024/07/09 09:49:00",
            "    @功能    :   设置控制台窗口的标题。",
            "            :param title: 要设置的窗口标题",
            "    # 仅在Windows上有效",
            "    '''",
            "    import ctypes",
            "    if os.name == 'nt':",
            "        kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)",
            "        kernel32.SetConsoleTitleW.argtypes = [ctypes.c_wchar_p]",
            "        if title is None:",
            "            kernel32.SetConsoleTitleW(r'$TM_FILENAME_BASE  $TM_FILEPATH')",
            "        else:",
