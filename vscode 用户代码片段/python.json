        "prefix": "GetTheCmdCodePage",
        "body": [
            "def GetTheCmdCodePage():",
            "    '''",
            "    @功能    :   获得cmd代码页",
            "    '''",
            "    code_page = os.popen('chcp').read()",
            "    code_page = code_page.strip()",
            "    if code_page == '':",
            "        print('unable to get the current code page')",
            "        return None",
            "    code_page = code_page.split(':')[-1].strip()  # 获取代码页数字部分",
            "    if code_page == '936':",
            "        print(f'【code_page:{code_page}】cmd使用中文代码页')",
            "        return 1",
            "    if code_page == '437':",
            "        print(f'code_page:{code_page}. cmd uses chinese code pages')",
            "        return 0",
            "    print('neither chinese nor english')",
            "    return -1",
        ]
    },
